{
  "name": "obsidian-csv-importer",
  "version": "0.2.0",
  "description": "View CSV files inside Obsidian and import every row as a note with correctly typed properties.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint styles.css && node scripts/check-api-versions.mjs",
    "typecheck": "tsc -noEmit -p tsconfig.json",
    "typecheck:test": "tsc -noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc -noEmit -p tsconfig.e2e.json",
    "pretest:e2e": "npm run build",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "pretest:e2e:mobile": "npm run build",
    "prescreenshots:readme": "npm run build",
    "screenshots:readme": "cross-env README_SCREENSHOTS=1 OBSIDIAN_VERSIONS=latest/latest wdio run ./wdio.conf.mts",
    "test:e2e:mobile": "cross-env E2E_MOBILE=only wdio run ./wdio.conf.mts",
    "check": "npm run typecheck && npm run typecheck:test && npm run typecheck:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint:css": "stylelint styles.css",
    "lint:api": "node scripts/check-api-versions.mjs",
    "test:mutation": "stryker run",
    "quality": "fallow --baseline .fallow-baselines/dead-code.json --dupes-baseline .fallow-baselines/dupes.json --health-baseline .fallow-baselines/health.json",
    "quality:baseline": "node scripts/fallow-baseline.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "csv",
    "import"
  ],
  "author": "Luis Mendez",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "fallow": "3.42.0",
    "globals": "^17.14.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.14.4",
    "obsidian-launcher": "^3.5.0",
    "stylelint": "^16.26.1",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tslib": "^2.9.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^9.33.1",
    "yaml": "^2.9.1"
  }
}
