{
  "name": "obsidian-csv-importer",
  "version": "1.0.0",
  "description": "View CSV files inside Obsidian and import every row as a note with correctly typed properties.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "csv",
    "import"
  ],
  "author": "Luis Mendez",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
